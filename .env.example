# Copy to .env.local for the local preview (pnpm build && pnpm preview).
# On Vercel, set the same names under Project → Settings → Environment Variables.
# Never commit a real key.

# Key from https://aistudio.google.com/apikey . Without it the chat bot keeps its ready-made answers.
GEMINI_API_KEY=

# Optional. Default: gemini-flash-lite-latest
# GEMINI_MODEL=
